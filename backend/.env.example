# Comma-separated Netlify URL(s) and local development origins.
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:8080,http://127.0.0.1:5500

# Supabase project settings. Keep the service-role key on the backend only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alternatively, use the newer Supabase secret key name:
# SUPABASE_SECRET_KEY=your-secret-key
