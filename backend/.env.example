# Comma-separated frontend origins. Add your Netlify site URL.
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:8080,http://127.0.0.1:5500

# Hugging Face Inference API. Keep this token on the backend only.
HF_API_TOKEN=hf_your_access_token
HF_MODEL_ID=facebook/bart-large-cnn

# Optional Supabase settings for visit and summary persistence.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
